{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:best-practices"
  ],
  "assignees": ["@curantes/maintainers"],
  "ignoreDeps": [
    "slsa-framework/slsa-github-generator"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "matchPackagePatterns": ["^registry\\.access\\.redhat\\.com/hi/"],
      "groupName": "redhat-hummingbird-base-images",
      "commitMessageTopic": "Red Hat Hummingbird base images"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions-dependencies",
      "schedule": ["before 4am on monday"]
    }
  ]
}
